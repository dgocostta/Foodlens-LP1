# Copy to .env.local for local dev, and set the same keys in Vercel -> Settings -> Environment Variables.
# .env.local is gitignored — never commit real credentials.

# --- Firebase Admin (server-side: Firestore + Storage) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full key WITH the BEGIN/END lines. If wrapped in quotes, escape newlines as \n.
FIREBASE_PRIVATE_KEY=
# Firebase Console -> Storage. The bucket id, e.g. your-project.firebasestorage.app (or your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM=FoodLens <noreply@send.foodlensgroup.com>
RESEND_REPLY_TO=
# Where internal "new signup" notifications are sent.
LEAD_NOTIFICATION_TO=info@foodlensgroup.com

# --- Admin dashboard ---
# Shared key required to open /admin and list leads. Pick something strong.
ADMIN_KEY=
